{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qozon-multi-agent-api",
  "account_id": "b0668461560fc6ead1ad55345b3437c4",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://srahimov.site",
    "QUESTIONS_PER_MINUTE": "5",
    "QUESTIONS_PER_DAY": "200",
    "INACTIVITY_SECONDS": "300"
  },
  "containers": [
    {
      "class_name": "QozonBackend",
      "scheduling_policy": "default",
      "image": "registry.cloudflare.com/b0668461560fc6ead1ad55345b3437c4/qozon-multi-agent-api@sha256:0c243af8a6e37ac440dd09638f1386d7a0585e6973da4a605d22491b57710ada",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "QozonBackend"
      }
    ]
  },
  "exports": {
    "QozonBackend": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
