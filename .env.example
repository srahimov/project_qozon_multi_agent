# Copy to the project's .env locally without overwriting an existing file.
# Never commit, print, or paste credentials into chat. Run commands from project_Qozon.
OPENAI_API_KEY=
QOZON_LANGUAGE=en
# Exact HTTPS React website origin; JSON array, no path/trailing slash.
QOZON_CORS_ORIGINS=["https://srahimov.site"]
QOZON_MODEL_PROVIDER=openai
QOZON_MODEL_NAME=gpt-6-luna
# The user-question limit is fixed at 200 original Unicode characters, including spaces/punctuation.
# Selected Phase 1 generation budget; separate from the question character limit.
QOZON_OUTPUT_MAX_TOKENS=512
# Local development defaults off; the release configuration enables these.
# Local/other hosting uses a persistent disk; Cloudflare uses Durable Object storage.
# Both require a stable random secret of at least 32 characters when enabled.
QOZON_QUESTION_LIMITS_ENABLED=false
# local uses this machine's SQLite; cloudflare requires internal edge admission.
QOZON_QUESTION_LIMITS_BACKEND=local
QOZON_QUESTION_LIMITS_DATABASE=data/request-limits.sqlite3
# Set QOZON_QUESTION_LIMIT_KEY privately when enabling limits (do not paste it).
QOZON_QUESTIONS_PER_MINUTE=5
QOZON_QUESTIONS_PER_DAY=100
# Independent Phase 2 ingestion model choices and generation budgets.
QOZON_TABLE_MODEL_NAME=gpt-5.6-terra
QOZON_IMAGE_MODEL_NAME=gpt-5.6-terra
QOZON_TABLE_OUTPUT_MAX_TOKENS=512
QOZON_IMAGE_OUTPUT_MAX_TOKENS=512
# Explicit checked workflow spans; automatic raw model tracing remains disabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=project_qozon
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Leave false for metadata/timing/token/citation observability only. Enable after
# authorizing checked questions, answers, and book passages in LangSmith:
QOZON_LANGSMITH_TRACE_CONTENT=false
# Optional for an API key with access to multiple workspaces:
# LANGSMITH_WORKSPACE_ID=
QOZON_EVALUATION_MODEL_NAME=gpt-5.6-terra
# Private PDF ingestion uses Storage credentials, separate from DATABASE_URL.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Public document reads use this publishable key with the anonymous database role.
# The privileged ingestion secret above is never a public database reader credential.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Separate public bucket for approved source pictures and tables:
SUPABASE_ASSETS_BUCKET=canon-of-medicine-chunks
# Locally verified public asset registry, read without network calls on queries:
QOZON_RAG_PUBLICATION_MANIFEST=data/pdf-assets/publication.json
# Enable after verifying the chosen index. Cloud comparison now passes for this corpus.
QOZON_RAG_ENABLED=false
# supabase (current configured backend) or chroma (local fallback):
QOZON_RAG_BACKEND=supabase
QOZON_EMBEDDING_MODEL_NAME=text-embedding-3-small
QOZON_EMBEDDING_DIMENSIONS=1536
QOZON_RAG_TOP_K=4
QOZON_RAG_MAX_DISTANCE=0.65
QOZON_RAG_CONTEXT_CHARACTERS=16000
